# Copy this file to .env and replace placeholders with local values.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=replace_with_your_sql_server
DB_NAME=replace_with_your_database
DB_USER=replace_with_your_username
DB_PASSWORD=
DB_COMMAND_TIMEOUT=120
APPIUM_SERVER_URL=http://appium.example.invalid:4723
ANDROID_DEVICE_UDID=replace_with_your_android_device_id
